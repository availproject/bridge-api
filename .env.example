# Network settings. All eight are required: the service does not start without them.
AVAIL_CLIENT_URL=
ETHEREUM_CLIENT_URL=
MERKLE_PROOF_SERVICE_URL=
BEACONCHAIN_URL=
VECTORX_CONTRACT_ADDRESS=
CONTRACT_CHAIN_ID=
AVAIL_CHAIN_NAME=
BRIDGE_CONTRACT_ADDRESS=

# Optional chains for /v1/head/<chain id> and /v1/proof/<chain id>. A chain needs both settings.
# Supported chain ids: 1, 123, 32657, 84532, 11155111, 17000, 421614.
# CHAIN_<INSERT CHAIN ID>_RPC_URL=
# CHAIN_<INSERT CHAIN ID>_CONTRACT_ADDRESS=

# Numbers. An empty value means the default. A value that is not a number stops the start.
ETH_HEAD_CACHE_MAXAGE=
HEAD_CACHE_MAXAGE=
AVL_HEAD_CACHE_MAXAGE=
AVL_PROOF_CACHE_MAXAGE=
ETH_PROOF_CACHE_MAXAGE=
ETH_PROOF_FAILURE_CACHE_MAXAGE=
PROOF_CACHE_MAXAGE=
MAX_CONCURRENT_REQUEST=
HELIOS_UPDATE_FREQUENCY=
VECTOR_UPDATE_FREQUENCY=

# Listen address and database. Remove a line to get the default. An empty value is used as it is.
HOST=
PORT=
POSTGRES_URL=
PG_USERNAME=
PG_PASSWORD=
POSTGRES_DB=
